{
  "expo": {
    "name": "Tenmina Field",
    "slug": "tenmina-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tenmina.field"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tenmina.field"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Tenmina Field uses the camera to take evidence photos for your jobs. Photos come only from this camera, never from your gallery.",
          "microphonePermission": "Tenmina Field records sound with evidence videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tenmina Field records where each photo is taken and where you check in, so the client knows the work was done on site."
        }
      ]
    ],
    "scheme": "tenminafield",
    "experiments": {
      "typedRoutes": true
    }
  }
}
